{
  "id": "hentaimama",
  "name": "HentaiMama",
  "version": "1.1.2",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Hentai 18+ en HD con subtítulos en inglés, desde HentaiMama. Solo se muestra con el código 18+ desbloqueado.",
  "author": "xuper-plugin",
  "homepage": "https://hentaimama.io/",
  "hosts": [
    "hentaimama.io",
    "gdvid.info",
    "*.gdvid.info"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "streamHosts": "any",
  "categories": [
    "adult"
  ],
  "color": "#E5457B",
  "section": {
    "label": "HentaiMama"
  },
  "theme": {
    "accent": "#E5457B",
    "onAccent": "#1F0510",
    "background": "#0E0A0C",
    "surface": "#1A1216",
    "highlight": "#FFC2D6"
  },
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "label": "Calidad preferida",
      "default": "1080p",
      "options": [
        {
          "value": "1080p",
          "label": "1080p"
        },
        {
          "value": "720p",
          "label": "720p"
        },
        {
          "value": "480p",
          "label": "480p"
        }
      ],
      "hint": "Las otras calidades y servidores quedan en el menú Servidor y calidad."
    },
    {
      "key": "homeRows",
      "type": "toggle",
      "label": "Filas en Inicio",
      "default": true,
      "hint": "Series y episodios recientes en el Inicio de Kino."
    },
    {
      "key": "cache",
      "type": "status",
      "label": "Caché"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "confirm": "¿Vaciar la caché de listas y episodios?"
    },
    {
      "key": "toolsSection",
      "type": "section",
      "label": "Herramientas"
    },
    {
      "key": "health",
      "type": "status",
      "label": "Estado"
    },
    {
      "key": "probe",
      "type": "action",
      "label": "Comprobar sitio"
    }
  ],
  "telemetry": true,
  "debug": false
}
