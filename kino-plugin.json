{
  "id": "hentaimama",
  "name": "HentaiMama",
  "version": "1.2.2",
  "apiVersion": 9,
  "entry": "plugin.js",
  "description": "Hentai 18+ en HD con subtítulos en inglés, desde HentaiMama. Solo se muestra con el código 18+ desbloqueado.",
  "author": "xuper-plugin",
  "homepage": "https://hentaimama.io/",
  "hosts": [
    "hentaimama.io",
    "gdvid.info",
    "*.gdvid.info",
    "hentaidoge.org",
    "*.javprovider.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "streamHosts": "any",
  "categories": [
    "adult"
  ],
  "color": "#E5457B",
  "section": {
    "label": "HentaiMama",
    "labelEn": "HentaiMama"
  },
  "theme": {
    "accent": "#E5457B",
    "onAccent": "#1F0510",
    "background": "#0E0A0C",
    "surface": "#1A1216",
    "highlight": "#FFC2D6"
  },
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "label": "Calidad preferida",
      "default": "1080p",
      "options": [
        {
          "value": "1080p",
          "label": "1080p"
        },
        {
          "value": "720p",
          "label": "720p"
        },
        {
          "value": "480p",
          "label": "480p"
        }
      ],
      "hint": "Las otras calidades y servidores quedan en el menú Servidor y calidad."
    },
    {
      "key": "homeRows",
      "type": "toggle",
      "label": "Filas en Inicio",
      "default": true,
      "hint": "Series y episodios recientes en el Inicio de Kino."
    },
    {
      "key": "cache",
      "type": "status",
      "label": "Caché"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "confirm": "¿Vaciar la caché de listas y episodios?"
    },
    {
      "key": "toolsSection",
      "type": "section",
      "label": "Herramientas"
    },
    {
      "key": "health",
      "type": "status",
      "label": "Estado"
    },
    {
      "key": "probe",
      "type": "action",
      "label": "Comprobar sitio"
    }
  ],
  "telemetry": true,
  "debug": false,
  "enhancements": {
    "14": {
      "capabilities": [
        "screen"
      ],
      "screen": {
        "label": "HentaiMama",
        "labelEn": "HentaiMama",
        "icon": "movie",
        "menuOpens": "screen",
        "opensFrom": [
          "menu",
          "settings"
        ],
        "settingsButton": {
          "label": "Abrir HentaiMama",
          "labelEn": "Open HentaiMama"
        },
        "settingsIn": "screen"
      }
    },
    "19": {
      "capabilities": [
        "screen"
      ]
    },
    "20": {
      "provides": {
        "catalog": {
          "summary": "Titles this plugin finds, for the author's other plugins",
          "calls": {
            "search": {
              "in": {
                "q": "string",
                "type": "string?"
              },
              "out": "Item[]"
            }
          },
          "types": {
            "Item": {
              "id": "string",
              "ref": "string",
              "title": "string",
              "kind": "string",
              "poster": "string?",
              "backdrop": "string?",
              "year": "string?",
              "overview": "string?",
              "tmdb": "number?"
            }
          }
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "ba71e03cdac6d1cbe32e5c89e22a840457a5269c990e7dd527e59e2674426eacecfe7edfcca16665793cbaaecff42bb14263ba80e7c6803e7412b67691f61d0b"
  }
}
